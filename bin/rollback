#!/usr/bin/env python3
"""Roll a run back: bin/rollback <run_id> [--json]. Assignment 5's working solution.
It ships in Assignment 6's starter as RepoMind's own.

For every write the run made, newest first, the compensating action the mock remote
exposes (checks/FORMATS.md, section 13.6): remove_label for a label, close_pr for a
pull request, reopen_issue for a closed issue. A comment, a push and a merge have no
compensation: it prints "none" for each and leaves it where it is. Rollback exists
only where someone wrote the compensation before it was needed (Lecture 5, slide 39).
"""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from harness.tracker import RemoteRefused, Tracker  # noqa: E402

HAPPENED = ("written", "timeout_after_commit")      # outcomes after which the write is on the remote
UNDO = {"apply_label": "remove_label", "open_pr": "close_pr", "close_issue": "reopen_issue"}


def rollback(run_id: str, tracker: Tracker | None = None) -> dict:
    tracker = tracker or Tracker(flaky=False, readback_fail=False)
    done = {"run_id": run_id, "compensated": [], "none": []}
    writes = [w for w in tracker.log(run_id) if w["outcome"] in HAPPENED and w["action"] not in UNDO.values()]
    seen = set()
    for w in reversed(writes):
        if (w["action"], w["target"]) in seen:
            continue
        seen.add((w["action"], w["target"]))
        by = UNDO.get(w["action"])
        if by is None:
            done["none"].append({"action": w["action"], "target": str(w["target"])})
            print(f"{w['action']:<13} {w['target']:<28} none: nothing offsets it; it stays")
            continue
        try:
            if by == "remove_label":
                row = next(r for r in tracker.labels(run_id, active=True) if r["label"] == w["target"])
                tracker.remove_label(run_id, row["id"])
            elif by == "close_pr":
                tracker.close_pr(run_id, int(str(w["target"]).removeprefix("pr-")))
            else:
                row = next(r for r in tracker.closes(run_id, active=True) if f"issue-{r['issue']}" == w["target"])
                tracker.reopen_issue(run_id, row["id"])
        except (StopIteration, RemoteRefused) as exc:
            print(f"{w['action']:<13} {w['target']:<28} {by}: not possible now ({exc or 'already offset'})")
            continue
        done["compensated"].append({"action": w["action"], "target": str(w["target"]), "by": by})
        print(f"{w['action']:<13} {w['target']:<28} {by}")
    return done


def main(argv) -> int:
    args = [a for a in argv if a != "--json"]
    if len(args) != 1:
        print(__doc__)
        return 2
    done = rollback(args[0])
    if "--json" in argv:
        print(json.dumps(done))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
