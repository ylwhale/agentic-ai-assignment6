{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoMind investigator return",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "status",
    "searched",
    "not_searched",
    "calls_used",
    "could_not_determine"
  ],
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "label", "file", "evidence"],
      "properties": {
        "issue": {"type": "integer"},
        "label": {"type": "string"},
        "file": {"type": "string"},
        "evidence": {"type": "string"}
      }
    },
    "status": {
      "type": "string",
      "enum": ["found", "candidate", "out_of_budget"]
    },
    "searched": {"type": "array", "items": {"type": "string"}},
    "not_searched": {"type": "array", "items": {"type": "string"}},
    "calls_used": {"type": "integer"},
    "could_not_determine": {"type": "array", "items": {"type": "string"}}
  }
}
